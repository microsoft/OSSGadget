{
	"name": "OSSGadget (.NET 8 + 6)",
	"build": {
		"dockerfile": "Dockerfile"
	},

	// The projects multi-target net6.0 and net8.0, so the .NET 6 runtime is needed to run net6.0 tests.
	"features": {
		"ghcr.io/devcontainers/features/dotnet:2": {
			"version": "8.0",
			"additionalVersions": "6.0"
		},
		"ghcr.io/devcontainers/features/sshd:1": {}
	},

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-dotnettools.csharp",
				"ms-dotnettools.csdevkit"
			]
		}
	},

	"postCreateCommand": "cd \"${containerWorkspaceFolder}/src\" && dotnet restore OSSGadget.sln",

	"remoteUser": "vscode"
}
